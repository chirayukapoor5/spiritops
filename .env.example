# Optional overrides. docker compose up --build works without an .env file.
SPIRITOPS_MODE=demo
SPIRITOPS_API_PORT=8000
SPIRITOPS_DASHBOARD_PORT=8501
SPIRITOPS_MLFLOW_PORT=5000
SPIRITOPS_PROMETHEUS_PORT=9090
SPIRITOPS_GRAFANA_PORT=3000
# Leaving this unset generates and persists a random local credential.
# SPIRITOPS_ADMIN_TOKEN=
# To run a tagged release, set SPIRITOPS_IMAGE to its published GHCR digest.
