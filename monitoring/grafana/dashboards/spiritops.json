{
  "title": "SpiritOps serving health",
  "uid": "spiritops",
  "tags": [
    "spiritops"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"spiritops\"}",
          "legendFormat": "API scrape health"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Worker availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "spiritops_worker_available",
          "legendFormat": "Worker availability"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Request throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "spiritops_throughput_per_second",
          "legendFormat": "Request throughput"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "P95 API latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "spiritops_p95_ms",
          "legendFormat": "P95 API latency"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Error rate over five minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(spiritops_errors_total[5m]) / (rate(spiritops_requests_total[5m]) > 0)",
          "legendFormat": "Error rate over five minutes"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "API resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spiritops-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "spiritops_rss_mb",
          "legendFormat": "API resident memory"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      }
    }
  ]
}
